{
  "name": "toko-replit",
  "version": "1.0.0",
  "description": "Implementasi mengikuti instruksi tugas: contoh toko dipisah menjadi `product-service` (port 3000) dan `order-service` (port 3001), keduanya diakses melalui gateway (port 8080). Data masih berupa array di memori, sesuai bahan praktikum.",
  "private": true,
  "scripts": {
    "start": "node start-services.js",
    "dev:product": "node product-service/product-service.js",
    "dev:order": "node order-service/order-service.js",
    "dev:gateway": "node gateway/gateway.js",
    "dev:gateway:replit": "PORT=5000 node gateway/gateway.js",
    "test": "node --test tests/api.test.js",
    "test:replit": "BASE_URL=http://127.0.0.1:5000 node --test tests/api.test.js",
    "monitor": "node monitor.js",
    "monitor:replit": "GATEWAY_URL=http://127.0.0.1:5000 node monitor.js",
    "smoke": "BASE_URL=http://127.0.0.1:5000 node smoke-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^4.22.3",
    "http-proxy-middleware": "^3.0.10"
  }
}
